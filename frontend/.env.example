# The frontend only renders and forwards: every read and write goes to the backend (NestJS, ../backend)
# through src/lib/api. Nothing here talks to the database, the media storage or Telegram.

# Internal address of the backend — never exposed to browsers (dev: `npm run start:dev` in backend/).
BACKEND_URL=http://127.0.0.1:4000
# Shared secret: the same value as INTERNAL_API_KEY in backend/.env (at least 32 characters)
INTERNAL_API_KEY=
# The admin signs in with the backend's account (backend/.env ADMIN_LOGIN / ADMIN_PASSWORD, created by
# `npm run db:seed` there); sessions are httpOnly cookies set by this server.

# Public site origin, used for canonical URLs, sitemap, Open Graph (prerendered pages keep the value they
# were built with: rebuild after a change)
SITE_URL=http://localhost:3000

# Optional: search engine ownership verification (meta tags), e.g. from Yandex.Webmaster / Google Search Console
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
