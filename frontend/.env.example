# PostgreSQL connection string (dev: docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://gadyuka:gadyuka@localhost:5432/gadyuka?schema=public

# Telegram bot for lead notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# 1 = do not call Telegram API (dev/tests); messages are logged instead and leads are
# marked «не отправлено». Production: 0 (with 1 the admin shows a warning banner).
TELEGRAM_DRY_RUN=1

# --- S3 media storage (MinIO) — uploads and seed images (src/lib/storage) ---
# Files are private in the bucket; the app streams them under /media/<key>.
# Dev values match docker-compose.dev.yml (npm run db:up starts MinIO; console http://127.0.0.1:9001).
# Production: docker-compose.yml overrides S3_ENDPOINT (http://minio:9000) and S3_FORCE_PATH_STYLE;
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are the app's OWN MinIO user (created by the minio-init
# service with rights on S3_BUCKET only) — e.g. gadyuka-app + openssl rand -hex 24, never the root user.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=gadyuka-media
S3_ACCESS_KEY_ID=gadyuka
S3_SECRET_ACCESS_KEY=gadyuka-minio
# 1 = path-style URLs (http://host/<bucket>/<key>) — required by MinIO; 0 = virtual-hosted (AWS S3)
S3_FORCE_PATH_STYLE=1

# Public site origin, used for canonical URLs, sitemap, OG
SITE_URL=http://localhost:3000

# Random secret (≥ 16 chars, e.g. openssl rand -hex 32) used to HMAC client IPs for lead
# rate limiting. REQUIRED in production (lead API refuses to work without it).
IP_HASH_SALT=

# Admin password. Dev: empty = open admin. Production: at least 16 characters
# (openssl rand -base64 24). Without it /admin is locked (fail closed) unless ADMIN_ALLOW_OPEN=1.
ADMIN_PASSWORD=
# Production only: 1 = admin WITHOUT a password, open to everyone.
# Owner's current decision (Oct 2026): the admin stays open for now → 1.
# To close it later: set ADMIN_PASSWORD (+ ADMIN_SESSION_SECRET) and clear this flag.
ADMIN_ALLOW_OPEN=1
# Recommended in production (openssl rand -hex 32, ≥ 32 chars): signs admin sessions together
# with the password; changing it logs every admin session out
ADMIN_SESSION_SECRET=

# Optional: search engine ownership verification (meta tags), e.g. from Yandex.Webmaster / Google Search Console
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# --- Production only (docker-compose.yml, see DEPLOY.md) ---
# Domain Caddy serves and gets a Let's Encrypt certificate for (SITE_URL must be https://<DOMAIN>)
DOMAIN=
# PostgreSQL bootstrap superuser of the `db` service (password: openssl rand -hex 24).
# Used only by the db container and the `tools` service (migrations, seed).
POSTGRES_USER=gadyuka
POSTGRES_PASSWORD=
POSTGRES_DB=gadyuka
# Least-privilege role the app connects as (DML only; created by deploy/postgres/initdb).
# In production DATABASE_URL above must be
#   postgresql://<APP_DB_USER>:<APP_DB_PASSWORD>@127.0.0.1:5432/<POSTGRES_DB>?schema=public
# (used by the image build); the app container overrides the host to `db`.
APP_DB_USER=gadyuka_app
APP_DB_PASSWORD=
# MinIO root user of the `minio` service (password: openssl rand -hex 24). Used only by the minio
# and minio-init containers (and backups); the app and the seed use S3_ACCESS_KEY_ID above.
MINIO_ROOT_USER=gadyuka-root
MINIO_ROOT_PASSWORD=
