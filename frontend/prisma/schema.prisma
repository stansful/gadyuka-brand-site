// ГАДЮКА — data model. See docs/ARCHITECTURE.md («Модель данных»).
//
// Conventions
// - Site UI copy lives in `Message` rows (key + locale), seeded from messages/<locale>.json —
//   the JSON files are the defaults and the source of the key set; the admin edits the rows.
// - Every translatable ENTITY field is `Json` holding LocalizedText = { [locale]: string }
//   (validated with zod in src/lib/i18n-text.ts on read and write). Adding a language
//   never requires a migration.
// - Media files live in S3 (MinIO): Media.key = "<admin|user>/<ownerId>/<uuid>/image.webp",
//   Media.url = the public link the site uses ("/media/<key>").
// - Optional media references use onDelete: SetNull; required ones (gallery, product
//   images) use Restrict so a file in use cannot be deleted by accident.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Who owns an upload; also the first segment of the S3 key ("admin/…", "user/…").
enum UserRole {
  ADMIN
  USER
}

enum SocialType {
  TELEGRAM
  VK
  INSTAGRAM
  WHATSAPP
  YOUTUBE
  TIKTOK
  PINTEREST
  WEBSITE
  OTHER
}

enum LeadType {
  TAILORING
  PARTNERSHIP
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

/// Accounts. For now a single ADMIN row created by the seed (the admin still signs in with
/// ADMIN_PASSWORD); USER rows are reserved for future site users (uploads, reviews).
model User {
  id        String   @id @default(cuid())
  role      UserRole
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media   Media[]
  reviews Review[]

  @@index([role])
}

/// One translation of one site UI string. `key` is the dotted path in messages/<locale>.json
/// (e.g. "hero.title", "forms.errors.required"). Rows are seeded from the JSON files; the
/// JSON value is also the render-time fallback when a row is missing.
model Message {
  key       String
  /// Locale code from src/i18n/locales.ts ("ru", "en")
  locale    String
  value     String    @db.Text
  /// null = value came from the seed (a re-seed may update it to a newer default);
  /// set = edited in the admin (the seed never touches it again unless SEED_OVERWRITE=1)
  editedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@id([key, locale])
  @@index([locale])
}

/// Landing images addressed by key (e.g. "about.image", "tailoring.image").
model ContentImage {
  key       String   @id
  mediaId   String?
  media     Media?   @relation("ContentImageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@index([mediaId])
}

model Media {
  id           String   @id @default(cuid())
  /// First segment of the S3 key: admin | user
  ownerType    UserRole
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// Per-upload folder in S3
  uuid         String   @unique @default(uuid()) @db.Uuid
  bucket       String
  /// S3 object key: "<admin|user>/<ownerId>/<uuid>/image.webp" (CHECK in migration)
  key          String
  /// Public link of the file, used as-is by the site and the admin ("/media/<key>")
  url          String
  mime         String
  width        Int
  height       Int
  /// Bytes
  size         Int
  /// LocalizedText
  alt          Json     @default("{}")
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contentImages    ContentImage[] @relation("ContentImageMedia")
  collectionCovers Collection[]   @relation("CollectionCover")
  productImages    ProductImage[]
  reviewAvatars    Review[]       @relation("ReviewAvatar")
  newsImages       NewsItem[]     @relation("NewsImage")
  galleryItems     GalleryItem[]
  offerImages      Offer[]        @relation("OfferImage")
  partnerLogos     Partner[]      @relation("PartnerLogo")
  ogImageSettings  SiteSettings[] @relation("SettingsOgImage")

  @@unique([bucket, key])
  @@index([ownerId, createdAt])
  @@index([createdAt])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// LocalizedText
  title       Json
  /// LocalizedText
  description Json      @default("{}")
  coverId     String?
  cover       Media?    @relation("CollectionCover", fields: [coverId], references: [id], onDelete: SetNull)
  order       Int       @default(0)
  published   Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, order])
  @@index([coverId])
}

model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  collectionId String
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// LocalizedText
  title        Json
  /// LocalizedText
  description  Json           @default("{}")
  /// LocalizedText (fabric, fit, print … — free text, one item per line)
  details      Json           @default("{}")
  /// Whole rubles; null = price on request
  price        Int?
  images       ProductImage[]
  order        Int            @default(0)
  published    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([collectionId, published, order])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order     Int     @default(0)

  @@unique([productId, mediaId])
  @@index([productId, order])
  @@index([mediaId])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  /// LocalizedText (e.g. «покупатель»)
  role      Json     @default("{}")
  /// LocalizedText
  text      Json
  avatarId  String?
  avatar    Media?   @relation("ReviewAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  /// 1..SiteSettings.reviewRatingMax (CHECK 1..10 in migration; the upper bound is validated
  /// against the current scale in the app)
  rating    Int?
  /// Future: the site user who wrote the review (null = added in the admin)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([avatarId])
  @@index([userId])
}

model NewsItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// LocalizedText
  title     Json
  /// LocalizedText
  excerpt   Json     @default("{}")
  /// LocalizedText (plain text / simple markdown)
  body      Json     @default("{}")
  date      DateTime
  imageId   String?
  image     Media?   @relation("NewsImage", fields: [imageId], references: [id], onDelete: SetNull)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date(sort: Desc)])
  @@index([imageId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  /// LocalizedText
  caption   Json     @default("{}")
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([mediaId])
}

model Offer {
  id         String    @id @default(cuid())
  /// LocalizedText
  title      Json
  /// LocalizedText
  text       Json      @default("{}")
  /// LocalizedText (e.g. «−15%»); empty object = no badge
  badge      Json      @default("{}")
  /// LocalizedText; empty object = no button
  ctaLabel   Json      @default("{}")
  ctaHref    String?
  validUntil DateTime?
  imageId    String?
  image      Media?    @relation("OfferImage", fields: [imageId], references: [id], onDelete: SetNull)
  order      Int       @default(0)
  published  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([published, order])
  @@index([imageId])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  url         String?
  logoId      String?
  logo        Media?   @relation("PartnerLogo", fields: [logoId], references: [id], onDelete: SetNull)
  /// LocalizedText
  description Json     @default("{}")
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
  @@index([logoId])
}

model Lead {
  id            String     @id @default(cuid())
  type          LeadType
  name          String
  email         String?
  phone         String?
  message       String     @db.Text
  /// Locale of the page the form was sent from
  locale        String
  status        LeadStatus @default(NEW)
  telegramSent  Boolean    @default(false)
  telegramError String?    @db.Text
  /// sha256(ip + IP_HASH_SALT), for rate limiting
  ipHash        String?
  /// Extra form data (user agent, referer, product slug …)
  meta          Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@index([telegramSent])
}

/// Exactly one row with id = 1 (CHECK constraint in migration).
model SiteSettings {
  id              Int      @id @default(1)
  phone           String   @default("")
  email           String   @default("")
  /// LocalizedText
  address         Json     @default("{}")
  /// Max stars of a review rating (CHECK 1..10 in migration)
  reviewRatingMax Int      @default(5)
  /// LocalizedText
  seoTitle        Json     @default("{}")
  /// LocalizedText
  seoDescription  Json     @default("{}")
  ogImageId       String?
  ogImage         Media?   @relation("SettingsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt
}

/// Site menu (header and/or footer). The admin can add, reorder, hide and remove items.
model MenuItem {
  id           String   @id @default(cuid())
  /// LocalizedText
  label        Json
  /// "#catalog" (landing anchor), "/catalog/<slug>" (localized site path), "https://…", "mailto:", "tel:"
  href         String
  showInHeader Boolean  @default(true)
  showInFooter Boolean  @default(true)
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, order])
}

/// Social / messenger links shown in the contacts section and JSON-LD sameAs.
model SocialLink {
  id        String     @id @default(cuid())
  type      SocialType
  /// LocalizedText; empty = the default label from messages (social.<type>)
  label     Json       @default("{}")
  url       String
  order     Int        @default(0)
  published Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([published, order])
}
