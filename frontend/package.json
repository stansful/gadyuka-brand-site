{
  "name": "gadyuka-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "postbuild": "node scripts/clean-standalone-env.mjs && node scripts/precompress.mjs",
    "compress-assets": "node scripts/precompress.mjs",
    "start": "next start --port 3001",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "intl-messageformat": "11.2.15",
    "lenis": "1.3.27",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
