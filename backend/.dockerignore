# Applies when backend/ is the build context. The production images are built from the repository
# root (shared/ is needed too) — that build uses the root .dockerignore / Dockerfile.dockerignore.

# Dependencies and build output (rebuilt inside the image)
node_modules
dist
.build
generated
coverage
.nyc_output

# Logs and runtime data
logs
*.log
*.pid
*.pid.lock

# Secrets: environment comes from the container, never from the image
.env
.env.*
!.env.example
!.env.test.example

# Tooling and editor files
.husky/_
.idea
.vscode
.DS_Store
docs/example-without-dot-env
