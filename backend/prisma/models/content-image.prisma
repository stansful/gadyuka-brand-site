/// Landing images addressed by key (e.g. "about.image", "tailoring.image").
model ContentImage {
  key       String   @id
  mediaId   String?  @map("media_id") @db.Uuid
  media     Media?   @relation("ContentImageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([mediaId])
  @@map("content_images")
}
