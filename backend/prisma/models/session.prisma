/// One sign-in: a family of rotated refresh tokens. Its id is the `sid` claim of the access tokens;
/// every authenticated request checks that the session is not revoked.
model Session {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// User-Agent of the sign-in request (shown to the admin; at most 512 characters)
  userAgent    String?              @map("user_agent")
  /// Last successful login / refresh
  lastUsedAt   DateTime             @default(now()) @map("last_used_at")
  /// Set = the session is over: no refresh, no access (even with an unexpired access token)
  revokedAt    DateTime?            @map("revoked_at")
  revokeReason SessionRevokeReason? @map("revoke_reason")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Refresh tokens: "<id>.<secret>" is handed out once, only sha256(secret) is stored. A token is
/// exchanged at most once (rotation); presenting an exchanged token again revokes the session.
model RefreshToken {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// sha256 of the secret part, lowercase hex (CHECK in the migration)
  tokenHash    String        @unique @map("token_hash")
  expiresAt    DateTime      @map("expires_at")
  /// Set when the token was exchanged or its session revoked
  revokedAt    DateTime?     @map("revoked_at")
  /// The token issued in exchange for this one
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenRotation")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
