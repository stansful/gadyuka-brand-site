# ГАДЮКА backend environment. Copy to .env (`cp .env.example .env`) and fill in the empty values.
# Secrets: `openssl rand -hex 32` (never reuse the dev values in production).
# The app validates every variable at startup (src/config) and refuses to start on a missing or bad one.

# Environment: dev, test, uat, prod (swagger UI at /api/v1/swagger only in dev)
NODE_ENV=dev

# Application. The backend is internal: only the Next.js server calls it (never exposed publicly).
APP_HOST=127.0.0.1
APP_PORT=4000
# Optional: also append JSON log lines to <LOG_DIR>/backend.log (production: the logs volume)
LOG_DIR=

# Postgres (docker-compose.yml publishes it on 127.0.0.1:${POSTGRES_PORT}; the URL is built from these parts)
POSTGRES_NAME=gadyuka
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=gadyuka
POSTGRES_PASS=

# MinIO server of docker-compose.yml (root user: only the minio / minio-init containers use it)
MINIO_ROOT_USER=gadyuka-root
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# S3 media storage (MinIO). The bucket is private: the backend serves files under /media/<key>.
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = the backend's own MinIO user (created by minio-init with
# rights on S3_BUCKET only), never the root user.
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=gadyuka-media
S3_ACCESS_KEY_ID=gadyuka-backend
S3_SECRET_ACCESS_KEY=
# 1 = path-style URLs (http://host/<bucket>/<key>) — required by MinIO; 0 = virtual-hosted (AWS S3)
S3_FORCE_PATH_STYLE=1

# Shared secret of the Next.js server: every request except GET|HEAD /media/* must send it as the
# x-internal-key header (at least 32 characters)
INTERNAL_API_KEY=

# Admin sessions: HS256 secret of the access tokens (at least 32 characters) and lifetimes in seconds
AUTH_ACCESS_SECRET=
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000

# Admin account: `npm run db:seed` creates or updates it (login: 3–64 of a-z 0-9 . _ @ -;
# password: at least 16 characters). Not needed by the running server.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Telegram bot for lead notifications (chat id the bot writes to)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# 1 = do not call the Telegram API (dev/tests): a redacted preview is logged and the lead is marked
# «не отправлено». Production: 0.
TELEGRAM_DRY_RUN=1

# Secret salt of client IP hashes (lead rate limiting), at least 16 characters
IP_HASH_SALT=

# Public site origin (links in Telegram messages, sitemap)
SITE_URL=http://localhost:3000
