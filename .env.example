# ГАДЮКА — production settings of docker-compose.yml (one file for the whole stack).
#
# deploy/up-caddy.sh and deploy/up-nginx.sh create .env from this file on the first run: they generate
# every secret (`openssl rand -hex …` — hex only, safe in URLs and shell commands), ask for the domain,
# the admin and Telegram, and set COMPOSE_FILE / VOLUMES_DIR. By hand: `cp .env.example .env`,
# `chmod 600 .env`, fill in every empty value. Never commit .env.
#
# After a change: run the up script again (or `sudo docker compose up -d`). DOMAIN / SITE_URL and the
# verification codes are built into the frontend image: the up script rebuilds it.

# ── Site ─────────────────────────────────────────────────────────────────────────────────────────────
# Domain without scheme; its DNS A (and AAAA) record must point to this server before the first start.
DOMAIN=
# Exactly https://<DOMAIN> without a trailing slash (canonical URLs, sitemap, Open Graph, Telegram links).
SITE_URL=
# 1 = also serve www.<DOMAIN> and redirect it to the apex (add the DNS record for www first).
WWW_REDIRECT=0

# ── Docker Compose ───────────────────────────────────────────────────────────────────────────────────
# The proxy variant (set by the up script): docker-compose.yml:docker-compose.caddy.yml or …nginx.yml —
# plain `docker compose …` in this folder then addresses the whole stack.
COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# Absolute path of the data folders (set by the up script: <home of the user who ran it>/docker-volumes/gadyuka).
VOLUMES_DIR=
# Host ports of the proxy (the only published ports).
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL 18 ────────────────────────────────────────────────────────────────────────────────────
POSTGRES_NAME=gadyuka
# Owner of the database (superuser of the container): migrations and the seed only.
POSTGRES_USER=gadyuka
POSTGRES_PASS=
# The role the backend runs as: rows only (SELECT/INSERT/UPDATE/DELETE), no schema changes. Created and
# kept up to date (password included) by the `migrate` service on every start.
APP_DB_USER=gadyuka_app
APP_DB_PASSWORD=

# ── MinIO (S3 storage of the images) ─────────────────────────────────────────────────────────────────
# Root user: only the minio / minio-init containers and the backups use it.
MINIO_ROOT_USER=gadyuka-root
MINIO_ROOT_PASSWORD=
# Private bucket; the backend serves it under /media/<key>.
S3_BUCKET=gadyuka-media
S3_REGION=us-east-1
# The backend's own MinIO user (minio-init creates it with rights on S3_BUCKET only); ≠ MINIO_ROOT_USER.
S3_ACCESS_KEY_ID=gadyuka-backend
S3_SECRET_ACCESS_KEY=

# ── Backend secrets ──────────────────────────────────────────────────────────────────────────────────
# Shared by the Next.js server and the backend (x-internal-key), at least 32 characters.
INTERNAL_API_KEY=
# HS256 secret of the admin access tokens (≥ 32); changing it signs every admin out.
AUTH_ACCESS_SECRET=
# Lifetimes in seconds: access token 15 min, refresh token 30 days.
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
# Salt of visitor IP hashes (lead rate limits), at least 16 characters.
IP_HASH_SALT=

# ── Admin (/admin) ───────────────────────────────────────────────────────────────────────────────────
# Created / updated by the seed on every start: a new password here ends the admin's sessions.
# Login: 3–64 of a-z 0-9 . _ @ -; password: at least 16 characters.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# ── Telegram (lead notifications) ────────────────────────────────────────────────────────────────────
# @BotFather → /newbot → token; open the bot and press Start; chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# 0 in production. 1 = do not call Telegram: leads are stored, marked «не отправлено», the admin warns.
TELEGRAM_DRY_RUN=0

# ── Search engines (optional; meta tags, rebuild needed — the up script does it) ─────────────────────
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── nginx variant only (deploy/up-nginx.sh) ──────────────────────────────────────────────────────────
# Let's Encrypt account e-mail (required for letsencrypt).
LETSENCRYPT_EMAIL=
# 1 = Let's Encrypt staging (untrusted test certificate, for a first try).
LETSENCRYPT_STAGING=0
# letsencrypt (default) or self-signed (local tests without public DNS).
NGINX_TLS_MODE=letsencrypt
