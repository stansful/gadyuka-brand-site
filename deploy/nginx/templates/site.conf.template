# ГАДЮКА — the site over HTTPS (rendered by nginx-start.sh once the certificate exists).
#
#   /_next/static/*, /brand/*  → files from /srv/static (published by the frontend container at start),
#                                .gz copies via gzip_static; a missing file goes to Next
#   /media/*                   → backend (images: ETag / 304, Range, immutable — passed through as is)
#   /admin…                    → Next, noindex, long timeouts (Telegram resend ≤ 50 s, text save ≤ 45 s)
#   everything else            → Next, gzip here (Accept-Encoding is not forwarded)
#
# Security headers are added in EVERY location (snippets/security-headers*.conf): nginx drops the
# server-level add_header of a location that has its own.

# Plain HTTP: the ACME challenge (renewals), the healthcheck, everything else → HTTPS.
server {
    listen 80 default_server;
    server_name _;

    include /etc/gadyuka-nginx/snippets/acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS for any other name (or no SNI): refuse the handshake instead of showing the site's certificate.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;
    include /etc/gadyuka-nginx/snippets/tls.conf;

    # 1. Build files from disk (content-hashed names: cached for a year).
    location ^~ /_next/static/ {
        root /srv/static;
        include /etc/gadyuka-nginx/snippets/static.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /brand/ {
        root /srv/static;
        include /etc/gadyuka-nginx/snippets/static.conf;
        add_header Cache-Control $gadyuka_brand_cache always;
    }

    # 2. Media straight from the backend: headers untouched (its sandbox CSP stays), never compressed.
    #    Only /media/* of the backend is public — its API needs the internal key and is not routed.
    location ^~ /media/ {
        proxy_pass http://gadyuka_backend;
        include /etc/gadyuka-nginx/snippets/proxy-common.conf;
        gzip off;
        proxy_hide_header X-Content-Type-Options;
        include /etc/gadyuka-nginx/snippets/security-headers-base.conf;
    }

    # 3. Admin media upload: the only large request body (15 MB file + multipart overhead).
    location = /admin/api/media {
        client_max_body_size 16m;
        include /etc/gadyuka-nginx/snippets/proxy-admin.conf;
    }

    location ^~ /admin/api/media/ {
        client_max_body_size 16m;
        include /etc/gadyuka-nginx/snippets/proxy-admin.conf;
    }

    # 4. The admin: never indexed, long-running actions.
    location /admin {
        include /etc/gadyuka-nginx/snippets/proxy-admin.conf;
    }

    # 5. Everything else: Next.js (also the fallback of the static locations).
    location / {
        include /etc/gadyuka-nginx/snippets/proxy-frontend.conf;
    }

    location @frontend {
        include /etc/gadyuka-nginx/snippets/proxy-frontend.conf;
    }
}
