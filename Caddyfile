# ГАДЮКА — Caddy (automatic HTTPS via Let's Encrypt). DOMAIN comes from .env (docker-compose.yml).
#
#   /uploads/*  → files straight from the uploads volume (mounted read-only at /srv/uploads)
#   everything else → Next.js (app:3000)

{$DOMAIN} {
	# Compression, in order of preference: zstd at its "better" level (about zstd -7; the HTML
	# carries the inlined CSS, ~10% smaller than the default level) for browsers that accept it,
	# gzip level 6 for the rest (Safari). Tiny responses (redirects, 304s) are sent as they are.
	encode {
		zstd better
		gzip 6
		minimum_length 256
	}

	# Security headers for every response. Deferred (because of `-Server`), so they replace
	# the identical copies that next.config.ts sets instead of duplicating them.
	# HSTS: add `; includeSubDomains` once EVERY subdomain of the domain is served over HTTPS
	# (DEPLOY.md, section 5) — it cannot be undone quickly once browsers cached it.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Baseline CSP for pages, the admin and the API (/uploads/* has its own sandbox CSP below).
	# No script-src yet: tighten with nonces later, starting with /admin.
	@notUploads not path /uploads/*
	header @notUploads {
		Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"
		defer
	}

	# Request body limits: only the admin media upload accepts large bodies (15 MB file +
	# multipart overhead; the app enforces 15.5 MB while streaming). Everything else — Server
	# Actions (Next limit 1 MB), the lead API (16 KB) — stays small.
	@mediaUpload path /admin/api/media /admin/api/media/*
	request_body @mediaUpload {
		max_size 16MiB
	}
	@notMediaUpload not path /admin/api/media /admin/api/media/*
	request_body @notMediaUpload {
		max_size 2MiB
	}

	# The admin is never indexed (in addition to robots.txt / noindex meta).
	header /admin* X-Robots-Tag "noindex, nofollow"

	handle /uploads/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
		file_server {
			hide .*
		}
	}

	handle {
		reverse_proxy app:3000 {
			# The app trusts X-Real-IP for lead rate limiting and the admin login throttle;
			# set it from the TCP peer (a client-supplied value is overwritten).
			header_up X-Real-IP {remote_host}
		}
	}

	log {
		output stdout
		format console
	}
}

# Optional: redirect www → apex. Add a DNS record for www first, then uncomment.
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
