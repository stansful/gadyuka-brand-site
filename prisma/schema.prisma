// ГАДЮКА — data model. See docs/ARCHITECTURE.md («Модель данных»).
//
// Conventions
// - Every translatable field is `Json` holding LocalizedText = { [locale]: string }
//   (validated with zod in src/lib/i18n-text.ts on read and write). Adding a language
//   never requires a migration.
// - Media.path is relative to UPLOAD_DIR (e.g. "seed/hoodie-white-logo.webp") and is
//   publicly served as `/uploads/<path>`.
// - Optional media references use onDelete: SetNull; required ones (gallery, product
//   images) use Restrict so a file in use cannot be deleted by accident.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentKind {
  TEXT
  RICHTEXT
  IMAGE
  LINK
}

enum LeadType {
  TAILORING
  PARTNERSHIP
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

/// Single-value content of landing sections. `key` is the dotted key used in
/// `data-edit` / `data-edit-img` attributes (e.g. "hero.cta", "tailoring.steps.0.title").
model ContentBlock {
  key       String      @id
  section   String
  kind      ContentKind @default(TEXT)
  /// LocalizedText for TEXT / RICHTEXT / LINK (LINK: the href, may be the same for all locales)
  value     Json?
  mediaId   String?
  media     Media?      @relation("ContentBlockMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  order     Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@index([section, order])
  @@index([mediaId])
}

model Media {
  id           String   @id @default(cuid())
  /// Relative to UPLOAD_DIR, forward slashes, no leading slash. Public URL: /uploads/<path>
  path         String   @unique
  mime         String
  width        Int
  height       Int
  /// Bytes
  size         Int
  /// LocalizedText
  alt          Json     @default("{}")
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contentBlocks    ContentBlock[] @relation("ContentBlockMedia")
  collectionCovers Collection[]   @relation("CollectionCover")
  productImages    ProductImage[]
  reviewAvatars    Review[]       @relation("ReviewAvatar")
  newsImages       NewsItem[]     @relation("NewsImage")
  galleryItems     GalleryItem[]
  offerImages      Offer[]        @relation("OfferImage")
  partnerLogos     Partner[]      @relation("PartnerLogo")
  ogImageSettings  SiteSettings[] @relation("SettingsOgImage")

  @@index([createdAt])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// LocalizedText
  title       Json
  /// LocalizedText
  description Json      @default("{}")
  coverId     String?
  cover       Media?    @relation("CollectionCover", fields: [coverId], references: [id], onDelete: SetNull)
  order       Int       @default(0)
  published   Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, order])
  @@index([coverId])
}

model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  collectionId String
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// LocalizedText
  title        Json
  /// LocalizedText
  description  Json           @default("{}")
  /// LocalizedText (fabric, fit, print … — free text, one item per line)
  details      Json           @default("{}")
  /// Whole rubles; null = price on request
  price        Int?
  images       ProductImage[]
  order        Int            @default(0)
  published    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([collectionId, published, order])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order     Int     @default(0)

  @@unique([productId, mediaId])
  @@index([productId, order])
  @@index([mediaId])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  /// LocalizedText (e.g. «покупатель»)
  role      Json     @default("{}")
  /// LocalizedText
  text      Json
  avatarId  String?
  avatar    Media?   @relation("ReviewAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  /// 1..5 (CHECK constraint in migration)
  rating    Int?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([avatarId])
}

model NewsItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// LocalizedText
  title     Json
  /// LocalizedText
  excerpt   Json     @default("{}")
  /// LocalizedText (plain text / simple markdown)
  body      Json     @default("{}")
  date      DateTime
  imageId   String?
  image     Media?   @relation("NewsImage", fields: [imageId], references: [id], onDelete: SetNull)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date(sort: Desc)])
  @@index([imageId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  /// LocalizedText
  caption   Json     @default("{}")
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([mediaId])
}

model Offer {
  id         String    @id @default(cuid())
  /// LocalizedText
  title      Json
  /// LocalizedText
  text       Json      @default("{}")
  /// LocalizedText (e.g. «−15%»); empty object = no badge
  badge      Json      @default("{}")
  /// LocalizedText; empty object = no button
  ctaLabel   Json      @default("{}")
  ctaHref    String?
  validUntil DateTime?
  imageId    String?
  image      Media?    @relation("OfferImage", fields: [imageId], references: [id], onDelete: SetNull)
  order      Int       @default(0)
  published  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([published, order])
  @@index([imageId])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  url         String?
  logoId      String?
  logo        Media?   @relation("PartnerLogo", fields: [logoId], references: [id], onDelete: SetNull)
  /// LocalizedText
  description Json     @default("{}")
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
  @@index([logoId])
}

model Lead {
  id            String     @id @default(cuid())
  type          LeadType
  name          String
  email         String?
  phone         String?
  message       String     @db.Text
  /// Locale of the page the form was sent from
  locale        String
  status        LeadStatus @default(NEW)
  telegramSent  Boolean    @default(false)
  telegramError String?    @db.Text
  /// sha256(ip + IP_HASH_SALT), for rate limiting
  ipHash        String?
  /// Extra form data (user agent, referer, product slug …)
  meta          Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@index([telegramSent])
}

/// Exactly one row with id = 1 (CHECK constraint in migration).
model SiteSettings {
  id             Int      @id @default(1)
  phone          String   @default("")
  email          String   @default("")
  /// LocalizedText
  address        Json     @default("{}")
  /// Array<{ type: string; url: string }>
  socials        Json     @default("[]")
  /// LocalizedText
  seoTitle       Json     @default("{}")
  /// LocalizedText
  seoDescription Json     @default("{}")
  ogImageId      String?
  ogImage        Media?   @relation("SettingsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
}
